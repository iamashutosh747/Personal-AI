# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Optional, server only. Used for exactly one thing: removing your auth
# account when you choose "Delete everything" in Settings. Without it, your
# data is still deleted but the empty login must be removed in the dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# The email address(es) allowed to create the account (comma separated).
# The database itself also refuses any second sign-up (see migrations).
ALLOWED_EMAILS=you@example.com

# ── Claude (console.anthropic.com → API keys) ─────────────────────
ANTHROPIC_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high — how much thinking Claude does per reply
CLAUDE_EFFORT=medium

# ── Optional: semantic memory search (voyageai.com) ──────────────
# Without it, retrieval uses Postgres full-text search.
VOYAGE_API_KEY=

# ── Optional: AI rate limits per user ─────────────────────────────
AI_RATE_PER_MINUTE=12
AI_RATE_PER_DAY=400
